# ─── MyRadar Backend — local development ──────────────────────────────────────
PORT=4000
NODE_ENV=development

# Origin that the browser connects from
FRONTEND_URL=http://localhost:3000

# ── AWS (optional — leave empty for demo mode) ─────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

DYNAMODB_TABLE=myradar-disaster-state
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
IOT_ENDPOINT=
S3_BUCKET=myradar-drone-imagery
