# ─── MyRadar — Environment Configuration ──────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# The platform works fully in DEMO mode without any AWS credentials.

# ── AWS toggle ─────────────────────────────────────────────────────────────────
# Set to "true" to enable all real AWS calls (DynamoDB, Bedrock, IoT)
AWS_ENABLED=false

# ── AWS credentials (server-side only — NEVER use NEXT_PUBLIC_ for secrets) ───
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=          # Only needed for temporary credentials / STS

# ── DynamoDB ───────────────────────────────────────────────────────────────────
# Table name that stores all operational state
DYNAMODB_TABLE=myradar-disaster-state

# ── Amazon Bedrock ─────────────────────────────────────────────────────────────
# Model for the MyRadar AI assistant
# Claude 3 Sonnet: anthropic.claude-3-sonnet-20240229-v1:0
# Claude 3 Haiku  (faster/cheaper): anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── AWS IoT Core ───────────────────────────────────────────────────────────────
# Endpoint hostname (no https://) e.g. xxxxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_ENDPOINT=

# ── Amazon Location Service ────────────────────────────────────────────────────
# (Used if you replace MapLibre with Amazon Location Service maps)
# These are public — safe to prefix NEXT_PUBLIC_
NEXT_PUBLIC_LOCATION_MAP_NAME=myradar-map
NEXT_PUBLIC_LOCATION_ROUTE_CALCULATOR=myradar-route-calculator

# ── Amazon S3 (drone imagery for Waste Radar) ──────────────────────────────────
S3_DRONE_BUCKET=myradar-drone-imagery

# ── Backend Express API (optional — can run alongside Next.js) ─────────────────
# If the Express backend is running, point this at it for AI + sync
# Leave blank to use the built-in Next.js API routes (/api/myradar/*)
NEXT_PUBLIC_API_URL=

# ── Frontend public flags ──────────────────────────────────────────────────────
# These are visible in the browser — keep them non-secret
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_APP_NAME=MyRadar
